# Local development (SQLite)
DATABASE_URL="file:./prisma/dev.db"

# Production (Turso) - get these from https://turso.tech
# TURSO_DATABASE_URL="libsql://your-db-name-your-org.turso.io"
# TURSO_AUTH_TOKEN="your-auth-token"

# Google Sheets – Film Catalogue (each tab = one film)
# Option A: API Key (simple – share sheet as "Anyone with the link")
# GOOGLE_API_KEY="AIza..."
# Option B: Service Account (share sheet with the SA email)
# GOOGLE_SERVICE_ACCOUNT_EMAIL="your-sa@project.iam.gserviceaccount.com"
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Required:
# GOOGLE_SHEET_ID="1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgVE2upms"

# Pipedrive
# PIPEDRIVE_API_TOKEN="your-pipedrive-api-token"
# PIPEDRIVE_DOMAIN="krutart"
# PIPEDRIVE_WEBHOOK_TOKEN="your-secret-webhook-token"
# PIPEDRIVE_FIELD_MAP='{"abc123_territory":"territory","def456_fee":"feeAmount"}'
