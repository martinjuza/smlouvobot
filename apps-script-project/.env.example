# .env.example - Environment variables template
# Copy this file to .env and fill in your actual values
# NEVER commit .env to git!

# Make.com webhook URL (keep secret!)
# Get this from your Make.com scenario webhook settings
MAKE_WEBHOOK_URL=https://hook.eu2.make.com/YOUR_WEBHOOK_ID_HERE

# Apps Script project ID
# Find this in Apps Script editor: Project Settings > Script ID
APPS_SCRIPT_ID=1SReMMnLUJuOl842N7mD75hCNNqUB-3oibhd0Yuovxy7o73gwjwyCbwj3

# Apps Script deployment ID (for documentation/testing)
# Find this in Apps Script editor: Deploy > Manage deployments
APPS_SCRIPT_DEPLOYMENT_ID=YOUR_DEPLOYMENT_ID_HERE

# Deployment URL (for quick access)
DEPLOYMENT_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID_HERE/exec

# Test URL with parameters (for development)
TEST_URL_PARAMS=?dealId=12345&clientName=Test+Company&email=test@example.com

# Notes:
# 1. In Apps Script, webhook URL should be set in Script Properties:
#    File > Project properties > Script properties > Add property
#    Key: MAKE_WEBHOOK_URL
#    Value: https://hook.eu2.make.com/...
#
# 2. For local sync.js, use credentials.json from Google Cloud Console
#
# 3. Never share these values or commit them to git
